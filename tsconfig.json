{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2017"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings"]
  },
  "include": ["app.ts", "typings/**/*.d.ts", "types/**/*.ts", "config/**/*.ts", "utils/**/*.ts", "services/**/*.ts", "pages/**/*.ts", "components/**/*.ts", "mock/**/*.ts"],
  "exclude": ["node_modules", "tests", "scripts", "dist"]
}
