/**
 * pages/mine/index.wxss —— 「我的」样式
 * 色值一律引用 app.wxss 页面级 CSS 变量；克制、温润。
 */

.page {
  min-height: 100vh;
  /* 底部预留自定义悬浮 tabBar 空间（含安全区适配） */
  padding: 56rpx 28rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.seal {
  width: 108rpx;
  height: 108rpx;
  border: 4rpx solid var(--color-ink);
  border-radius: 22rpx;
  color: var(--color-ink);
  font-size: 58rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-4deg);
  background-color: var(--color-surface);
}

.app-name {
  margin-top: var(--space-md);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--color-text);
}

.motto {
  margin-top: var(--space-sm);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-secondary);
}

/* ---------- 通用分区 ---------- */
.section {
  margin-top: var(--space-xl);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--color-text);
  margin-bottom: var(--space-md);
  padding: 0 4rpx;
}

.note-card {
  padding: 10rpx 30rpx;
}

/* ---------- 数据说明 ---------- */
.note-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
}

.note-row + .note-row {
  border-top: 2rpx solid var(--color-border);
}

.note-key {
  width: 158rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--color-ink);
  font-weight: 600;
  line-height: 1.7;
}

.note-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* ---------- 隐私说明 ---------- */
.privacy-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
}

.privacy-row + .privacy-row {
  border-top: 2rpx solid var(--color-border);
}

.privacy-dot {
  flex-shrink: 0;
  width: 44rpx;
  color: var(--color-ink);
  font-size: 26rpx;
  line-height: 1.7;
}

/* ---------- 关于 ---------- */
.about-card {
  padding: 40rpx 36rpx;
}

.about-text {
  font-size: 28rpx;
  line-height: 2;
  letter-spacing: 2rpx;
  text-align: center;
  color: var(--color-text);
}

/* ---------- 页脚 ---------- */
.page-footer {
  margin-top: var(--space-xl);
  padding: 0 var(--space-md);
  text-align: center;
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--color-neutral);
}

.footer-sub {
  font-size: 21rpx;
}
