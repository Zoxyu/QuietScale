<!-- pages/market-guide/index.wxml —— 「菜场指南」 -->
<view class="page">

  <!-- 顶部标题 + 数据等级徽标 -->
  <view class="header fade-in-up">
    <view class="title-block">
      <view class="title-row">
        <view class="seal">秤</view>
        <view>
          <view class="title">菜场指南</view>
          <view class="subtitle">参考价 · 挑选 · 时令</view>
        </view>
      </view>
    </view>
    <view wx:if="{{gradeLabel}}" class="grade-badge">{{gradeLabel}}</view>
  </view>

  <!-- 断更沿用说明：仅在数据服务透出 carryNote 时展示（弱化字色） -->
  <view wx:if="{{carryNote}}" class="carry-note">{{carryNote}}</view>

  <!-- A. 城市（省市两级 + 定位）与渠道 -->
  <view class="card selector-card fade-in-up">
    <view class="selector-block">
      <view class="selector-label-row">
        <text class="selector-label">城市</text>
        <view class="locate-btn" hover-class="locate-hover" hover-stay-time="80" bindtap="onRelocate">
          <text>{{locating ? '定位中…' : '重新定位'}}</text>
        </view>
      </view>
      <view class="region-row">
        <picker
          class="region-picker"
          mode="selector"
          range="{{provinces}}"
          range-key="name"
          value="{{provinceIndex}}"
          bindchange="onProvinceChange"
        >
          <view class="region-field">{{provinces[provinceIndex].name}}<text class="region-arrow">⌄</text></view>
        </picker>
        <picker
          class="region-picker"
          mode="selector"
          range="{{cities}}"
          range-key="name"
          value="{{cityIndex}}"
          bindchange="onCityChange"
        >
          <view class="region-field">{{cities[cityIndex].name}}<text class="region-arrow">⌄</text></view>
        </picker>
      </view>
      <view wx:if="{{locationHint}}" class="location-hint">{{locationHint}}</view>
    </view>
    <view class="selector-block">
      <view class="selector-label">渠道</view>
      <view class="channel-track">
        <view
          wx:for="{{channelOptions}}"
          wx:key="key"
          class="chip {{channel === item.key ? 'chip-active' : ''}}"
          data-key="{{item.key}}"
          bind:tap="onChannelTap"
        >{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- B. 今日参考价 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">今日参考价</text>
      <text class="section-sub">单位以条目为准</text>
      <view
        class="refresh-btn {{refreshing ? 'refresh-btn-busy' : ''}}"
        hover-class="refresh-hover"
        hover-stay-time="80"
        bindtap="onRefreshTap"
      >{{refreshing ? '刷新中…' : '刷新数据'}}</view>
    </view>

    <view wx:if="{{filterNote}}" class="filter-note">{{filterNote}}</view>

    <view wx:if="{{loading}}" class="empty-card card">正在为你整理参考价…</view>
    <view wx:elif="{{!groups.length}}" class="empty-card card">该城市暂未接入参考数据，换个城市或渠道试试。</view>
    <block wx:else>
      <!-- 数据驱动：按品类分组展示（组内按品名排序；key 为「品类名+组序号」的稳定唯一键） -->
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="key" class="category-group">
        <view class="category-group-title">
          <text class="category-group-name">{{group.name}}</text>
          <text class="category-group-count">{{group.count}} 项</text>
        </view>
        <price-item
          wx:for="{{group.items}}"
          wx:key="id"
          item="{{item}}"
          bind:open="onItemOpen"
        />
      </view>
    </block>
  </view>

  <!-- C. 我看到的价格 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">我看到的价格</text>
      <text class="section-sub">对比近期参考，心里有数</text>
    </view>

    <view class="card judge-card">
      <picker
        mode="selector"
        range="{{observedPickerRange}}"
        value="{{observedIndex}}"
        bindchange="onObservedPick"
        disabled="{{!observedPickerRange.length}}"
      >
        <view class="picker-field tap-area">
          <text class="picker-label">商品</text>
          <text class="picker-value {{observedName ? '' : 'picker-placeholder'}}">
            {{observedName || '请先选择一个商品'}}
          </text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>

      <view class="price-field">
        <text class="picker-label">我看到的价格</text>
        <view class="price-input-wrap">
          <input
            class="price-input"
            type="digit"
            placeholder="输入价格"
            placeholder-class="price-placeholder"
            value="{{observedPriceInput}}"
            bindinput="onPriceInput"
            disabled="{{!observedPickerRange.length}}"
          />
          <text class="price-unit">{{observedUnit || '元'}}</text>
        </view>
      </view>

      <!-- 判断结果 -->
      <view wx:if="{{judgeView}}" class="judge-result {{judgeView.theme}}">
        <view class="judge-head">
          <text class="judge-symbol">{{judgeView.symbol}}</text>
          <text class="judge-level">{{judgeView.levelLabel}}</text>
        </view>
        <view class="judge-basis">{{judgeView.basis}}</view>
        <view class="judge-disclaimer">{{judgeView.disclaimer}}</view>
      </view>
      <view wx:elif="{{observedPickerRange.length}}" class="judge-hint">
        输入价格后，会为你对比近期参考价。
      </view>
    </view>
  </view>

  <!-- D. 新手挑选指南 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">新手挑选指南</text>
      <text class="section-sub">看什么 · 避什么 · 怎么买</text>
    </view>
    <guide-card
      wx:for="{{guideCards}}"
      wx:key="title"
      no="{{index + 1}}"
      title="{{item.title}}"
      look="{{item.look}}"
      avoid="{{item.avoid}}"
      buy="{{item.buy}}"
      tip="{{item.tip}}"
    />
  </view>

  <!-- E. 份量与重量换算器 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">份量与重量换算</text>
      <text class="section-sub">斤两克，一次说明白</text>
    </view>
    <portion-converter />
  </view>

  <!-- F. 当季时令雷达 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">当季时令雷达</text>
      <text class="section-sub">{{seasonalMonth}} 月供应速览</text>
    </view>
    <seasonal-radar
      items="{{seasonalItems}}"
      picks="{{seasonalPicks}}"
      month="{{seasonalMonth}}"
      tip="{{seasonalTip}}"
      groups="{{seasonalGroups}}"
    />
  </view>

  <view class="page-footer">参考区间仅供比价，实际价格受品质、产地与渠道影响。</view>
</view>
