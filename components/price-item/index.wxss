/**
 * components/price-item/index.wxss —— 参考价条目样式
 * 弱化态（低置信度 / 季节经验 / 估算）用浅杏浅底，不用红色。
 */

.item {
  min-height: 88rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  background-color: var(--color-surface);
  border-radius: var(--radius-card);
  box-shadow: 0 6rpx 24rpx rgba(61, 58, 51, 0.05);
  padding: 28rpx 30rpx;
  margin-bottom: var(--space-md);
  transition: all 180ms ease;
}

.item-hover {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(61, 58, 51, 0.06);
}

/* 弱化态：浅杏浅底 + 虚线描边，传达「仅供参考」而非警示 */
.item-muted {
  background-color: var(--color-warn-bg);
  border: 2rpx dashed rgba(242, 196, 141, 0.9);
  box-shadow: none;
}

.item-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-md);
}

.item-head {
  display: flex;
  align-items: center;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 1rpx;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 置信度徽标：文字 + 颜色双重表达 */
.conf {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: 20rpx;
  line-height: 1;
  padding: 7rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid transparent;
}

.conf-high {
  color: var(--color-ink);
  border-color: var(--color-ink);
  background-color: var(--color-win-bg);
}

.conf-medium {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background-color: var(--color-surface);
}

.conf-low {
  color: #7A5B2E;
  background-color: var(--color-warn);
}

.item-spec {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.item-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.level-badge {
  color: var(--color-ink);
}

.meta-dot {
  margin: 0 8rpx;
  color: var(--color-neutral);
}

/* 批发条目行内固定小字 */
.wholesale-note {
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background-color: var(--color-warn-bg);
  color: #7A5B2E;
  font-size: 22rpx;
  line-height: 1.5;
}

.item-muted .wholesale-note {
  background-color: rgba(255, 255, 255, 0.65);
}

/* 右侧价格区 */
.item-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
}

.price-range {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}

.price-unit {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.price-median {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.median-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
}
