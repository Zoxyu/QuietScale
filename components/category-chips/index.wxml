<!-- components/category-chips/index.wxml —— 分类 chips（两行排列，无需横滑） -->
<view class="chips">
  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="chip {{index === activeIndex ? 'chip-active' : ''}}"
    hover-class="chip-hover"
    data-index="{{index}}"
    bindtap="onTap"
  >{{item.name}}</view>
</view>
