/**
 * components/category-chips/index.wxss —— 分类 chips 样式
 * 两行排列（3+3），无需横向滚动，所有分类一目了然。
 */

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-lg);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* 点击热区 ≥ 88rpx；换行间距由 margin 控制 */
  min-height: 88rpx;
  padding: 0 32rpx;
  margin: 0 var(--space-sm) var(--space-sm) 0;
  border-radius: var(--radius-pill);
  background-color: var(--color-surface);
  border: 2rpx solid var(--color-border);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-secondary);
  transition: all 180ms ease;
  flex-shrink: 0;
}

.chip-hover {
  opacity: 0.75;
}

/* 选中态：墨绿底白字 */
.chip-active {
  background-color: var(--color-ink);
  border-color: var(--color-ink);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(47, 79, 62, 0.22);
}
