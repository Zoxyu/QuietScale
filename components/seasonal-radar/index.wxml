<!-- components/seasonal-radar/index.wxml —— 当季时令雷达 -->
<view class="radar card">
  <!-- 横滑品类选择 -->
  <scroll-view class="pick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="pick-track">
      <view
        wx:for="{{picks}}"
        wx:key="*this"
        class="pick {{index === selectedIndex ? 'pick-active' : ''}}"
        data-index="{{index}}"
        bind:tap="onPick"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 12 个月圆点矩阵 -->
  <view class="matrix">
    <view class="matrix-label">「{{selectedName}}」全年供应</view>
    <view class="dots">
      <view
        wx:for="{{dots}}"
        wx:key="m"
        class="dot-cell"
      >
        <view class="now-line {{item.isNow ? 'now-line-on' : ''}}"></view>
        <view class="dot {{item.active ? 'dot-on' : ''}} {{item.isNow ? 'dot-now' : ''}}"></view>
        <text class="dot-m {{item.isNow ? 'dot-m-now' : ''}}">{{item.m}}</text>
      </view>
    </view>
    <view class="matrix-key">
      <view class="key-item"><view class="key-dot key-on"></view><text>当季</text></view>
      <view class="key-item"><view class="key-dot key-off"></view><text>非当季</text></view>
      <view class="key-item"><view class="key-dot key-now"></view><text>本月</text></view>
    </view>
  </view>

  <!-- 三组拆分 -->
  <view class="groups" wx:if="{{groups}}">
    <view class="group">
      <view class="group-head">
        <text class="group-title">当季优选</text>
        <text class="group-sub">通常更适合关注的菜</text>
      </view>
      <view class="chips">
        <view
          wx:for="{{groups.best}}"
          wx:key="name"
          wx:if="{{index < 8 || expandedBest}}"
          class="chip chip-best"
        >{{item.name}}</view>
        <view
          wx:if="{{groups.bestMore > 0 && !expandedBest}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onExpandMore"
          data-group="best"
        >…另有 {{groups.bestMore}} 样</view>
        <view
          wx:if="{{expandedBest}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onCollapseMore"
          data-group="best"
        >收起</view>
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-title">平稳供应</text>
        <text class="group-sub">全年供应较稳定</text>
      </view>
      <view class="chips">
        <view
          wx:for="{{groups.stable}}"
          wx:key="name"
          wx:if="{{index < 8 || expandedStable}}"
          class="chip chip-stable"
        >{{item.name}}</view>
        <view
          wx:if="{{groups.stableMore > 0 && !expandedStable}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onExpandMore"
          data-group="stable"
        >…另有 {{groups.stableMore}} 样</view>
        <view
          wx:if="{{expandedStable}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onCollapseMore"
          data-group="stable"
        >收起</view>
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-title">反季或供应偏少</text>
        <text class="group-sub">可能存在季节溢价</text>
      </view>
      <view class="chips">
        <view
          wx:for="{{groups.offSeason}}"
          wx:key="name"
          wx:if="{{index < 8 || expandedOffSeason}}"
          class="chip chip-off"
        >{{item.name}}</view>
        <view
          wx:if="{{groups.offSeasonMore > 0 && !expandedOffSeason}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onExpandMore"
          data-group="offSeason"
        >…另有 {{groups.offSeasonMore}} 样</view>
        <view
          wx:if="{{expandedOffSeason}}"
          class="chip chip-more"
          hover-class="chip-more-hover"
          hover-stay-time="80"
          bind:tap="onCollapseMore"
          data-group="offSeason"
        >收起</view>
      </view>
    </view>
  </view>

  <!-- 固定时令提示 -->
  <view class="radar-tip">{{tip}}</view>
</view>
