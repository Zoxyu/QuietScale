/**
 * components/guide-card/index.wxss —— 新手挑选指南折叠卡样式
 * 展开收起：display 切换 + 展开淡入（仅 opacity/transform，GPU 合成层动画，
 * 不触发 layout 重算；避免 max-height 动画在部分机型上白屏闪烁）。
 */

.guide {
  margin-bottom: var(--space-md);
  overflow: hidden;
}

.hover-soft {
  background-color: rgba(61, 58, 51, 0.05);
}

/* ---------- 头部 ---------- */
.guide-head {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.guide-title-wrap {
  display: flex;
  align-items: center;
}

/* 序号小徽标：墨绿描边圆角方块 */
.guide-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  flex-shrink: 0;
  transition: all 180ms ease;
}

.guide-open .guide-no {
  border-color: var(--color-ink);
  color: var(--color-ink);
  background-color: var(--color-win-bg);
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.guide-arrow {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  transform: rotate(-90deg);
  transition: transform 240ms ease;
}

.guide-open .guide-arrow {
  transform: rotate(0deg);
  color: var(--color-ink);
}

/* ---------- 折叠主体 ---------- */
.guide-body {
  display: none;
}

.guide-open .guide-body {
  display: block;
  animation: guide-fade-in 200ms ease;
}

/* 展开淡入：仅合成层属性，低端机型不闪烁 */
@keyframes guide-fade-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.guide-body-inner {
  padding: 4rpx 30rpx 28rpx;
}

.guide-row {
  display: flex;
  align-items: flex-start;
}

.guide-row + .guide-row {
  margin-top: var(--space-sm);
}

/* 段落标签：看 / 避 / 买 / 提示 */
.row-tag {
  flex-shrink: 0;
  min-width: 64rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  margin-top: 2rpx;
}

.tag-look {
  background-color: var(--color-win-bg);
  color: var(--color-ink);
}

.tag-avoid {
  background-color: var(--color-warn-bg);
  color: #7A5B2E;
}

.tag-buy {
  background-color: rgba(47, 79, 62, 0.08);
  color: var(--color-ink);
}

.tag-tip {
  background-color: #F3F1EC;
  color: var(--color-text-secondary);
}

.row-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--color-text);
}
